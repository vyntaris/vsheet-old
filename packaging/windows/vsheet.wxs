<?xml version="1.0" encoding="utf-8"?>
<!--
  VSheet MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build vsheet.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, App Paths (Win+R `vsheet`),
  and VSheet offered under "Open with" (and in Settings > Default apps) for .xlsx, .xlsm,
  .csv and .tsv, without taking over the user's default app for them.

  UpgradeCode is fixed for VSheet (generated 2026-10-07): never change it, or upgrades
  install side by side instead of replacing the old version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="VSheet"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="5511327B-F305-41BE-92D0-EB84944E7C4D"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="VSheet spreadsheet" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of VSheet is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VsheetIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="VsheetIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/vsheet" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/vsheet" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VSheet" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="VSheet" Level="1">
      <ComponentGroupRef Id="VsheetFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="VsheetFiles" Directory="INSTALLFOLDER">
      <Component Id="VsheetApp" Guid="0507D4B6-12FF-4882-84E1-59083E74A4EB">
        <File Id="VsheetExe" Source="$(var.BinDir)\vsheet.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="VSheet"
              Description="VSheet spreadsheet" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="VsheetIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\vsheet.exe" Value="[#VsheetExe]" Type="string" />

        <!-- ProgIds: how Explorer opens a file with VSheet. Nothing here sets HKCR\.<ext>'s
             default value, so the user's current default app is left alone. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\VSheet.Workbook" Value="VSheet Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\VSheet.Workbook\DefaultIcon" Value="&quot;[#VsheetExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\VSheet.Workbook\shell\open\command" Value="&quot;[#VsheetExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\VSheet.TextData" Value="VSheet Text Data" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\VSheet.TextData\DefaultIcon" Value="&quot;[#VsheetExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\VSheet.TextData\shell\open\command" Value="&quot;[#VsheetExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- "Open with": Windows reads only the value names under OpenWithProgids; the data is
             ignored (WiX rejects an empty Value, so it repeats the ProgId). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsx\OpenWithProgids" Name="VSheet.Workbook" Value="VSheet.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsm\OpenWithProgids" Name="VSheet.Workbook" Value="VSheet.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.csv\OpenWithProgids" Name="VSheet.TextData" Value="VSheet.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tsv\OpenWithProgids" Name="VSheet.TextData" Value="VSheet.TextData" Type="string" />

        <!-- Settings > Default apps: lets the user pick VSheet for these types. -->
        <RegistryValue Root="HKLM" Key="Software\VSheet\Capabilities" Name="ApplicationName" Value="VSheet" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\VSheet\Capabilities" Name="ApplicationDescription" Value="Open-source spreadsheet for .xlsx, CSV and TSV files" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\VSheet\Capabilities\FileAssociations" Name=".xlsx" Value="VSheet.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\VSheet\Capabilities\FileAssociations" Name=".xlsm" Value="VSheet.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\VSheet\Capabilities\FileAssociations" Name=".csv" Value="VSheet.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\VSheet\Capabilities\FileAssociations" Name=".tsv" Value="VSheet.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="VSheet" Value="Software\VSheet\Capabilities" Type="string" />
      </Component>

      <Component Id="VsheetCli">
        <File Id="VsheetCliExe" Source="$(var.BinDir)\vsheet-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
